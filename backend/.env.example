HALO_SERVER__HOST=0.0.0.0
HALO_SERVER__PORT=8080
HALO_DATABASE__URL=postgres://halo:halo@localhost:5432/halo
HALO_DATABASE__MAX_CONNECTIONS=10
HALO_JWT__SECRET=change-me-to-a-random-secret-256bits
HALO_JWT__ACCESS_TOKEN_EXPIRATION_SECS=900
HALO_JWT__REFRESH_TOKEN_EXPIRATION_SECS=604800
HALO_JWT__ISSUER=halo-server
HALO_OBSERVABILITY__LOG_LEVEL=info
HALO_OBSERVABILITY__LOG_FORMAT=pretty
HALO_OBSERVABILITY__ENABLE_METRICS=false
